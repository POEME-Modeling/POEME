# ====================================================
#        SIMPLE TURBOFAN CYCLE PERFORMANCE MODEL
# ====================================================

# BUGS and ERRORS
# static pressure is incorrect for start fluid node, possibly all flow stations
# can't have zero cooling flow taken from a compressor
# python's formatted output doesn't work with RealT
# maps have to be placed in the model and can't be reused or imported in scope



exec( open( "pop.std").read())

loadDirectory( "../pop" ) 
loadDirectory( "../Brayton" ) 


exec( open( "temp.include").read())
import varsg
varsg.out = open( "pop.out", "a")
# create all of the component objects, including the shaft connection ports
# ------------------------------------- 
start = FlightConditions( "start" )
#start = FN( 0 )
#start.comp = StringT( 0, v="canteraFN" )
inlet = Duct( "inlet" )
fan = Compressor( "fan" )
splitter = Splitter( "splitter" )
LPC = Compressor( "LPC" )
HPC = Compressor( "HPC" )
burner = Burner( "burner" )
HPT = Turbine( "HPT" )
LPT = Turbine( "LPT" )
priNozzle = Nozzle( "priNozzle" )
fanNozzle = Nozzle( "fanNozzle" )
HPshaft = Shaft( "HPshaft" )
LPshaft = Shaft( "LPshaft" )

LPshaft.MPfan = MP( LPshaft, io="in" )
LPshaft.MPlpc = MP( LPshaft, io="in" )
LPshaft.MPlpt = MP( LPshaft, io="in" )

HPshaft.MPC = MP( HPshaft, io="in" )
HPshaft.MPT = MP( HPshaft, io="in" )

buttmunch = Perf( "buttmunch" )



# link the objects together
# ------------------------------------- 
inlet.FNi.linkFN( start.FNo )
fan.FNi.linkFN( inlet.FNo )
splitter.FNi.linkFN( fan.FNo )
fanNozzle.FNi.linkFN( splitter.FNo2 )
LPC.FNi.linkFN( splitter.FNo1 )
HPC.FNi.linkFN( LPC.FNo )
burner.FNi.linkFN( HPC.FNo )
HPT.FNi.linkFN( burner.FNo )
LPT.FNi.linkFN( HPT.FNo )
priNozzle.FNi.linkFN( LPT.FNo )

LPshaft.MPfan.linkMP( fan.MP )
LPshaft.MPlpc.linkMP( LPC.MP )
LPshaft.MPlpt.linkMP( LPT.MP )

HPshaft.MPC.linkMP( HPC.MP )
HPshaft.MPT.linkMP( HPT.MP )

HPT.FNiBld1.linkFN( HPC.FNoBld2 )
HPT.FNiBld2.linkFN( HPC.FNoBld1 )



# set component variable values to match N+3 reference cycle at SLS
# ------------------------------------- 
start.alt.set( 0. )
start.MN.set( 0.25 )
start.W.set( 1726.57 )
start.comp.set( "canteraFN" )


start.calc()
print( start.Pamb, start.FNo.Ps, start.Tamb, start.FNo.Ts )

