
exec( open( "pop.std").read())




exec( open( "pop.std").read())

loadDirectory( "../pop" ) 
loadDirectory( "../Electrical" ) 

exec( open( "temp.include").read())
import varsg
varsg.out = open( "pop.out", "a")
varsg.pretty = open( "pretty.out", "a")


R = Resistor( "R" )
R.R.set( 470. )

C1 = Capacitor( "C1" )
C1.C.set( 4.7*10**-6 )
          
I = Inductor( "I" )
I.L.set( 65.*10.**-2)

C2 = Capacitor( "C2" )
C2.C.set( 1.5*10**-6 )

S1 = Esource( "S1" )
S1.Vr.set( 120. )

E1 = Enode( "E1" )
E1.Vr.set( -50. )
E1.Vi.set( 10. )

E2 = Enode( "E2" )
E2.Vr.set( -50. )
E2.Vi.set( 10. )


S2 = Esource( "S2" )

varsg.set( "freq", 60. )

C1.EPi.linkE( S1 )
C1.EPo.linkE( E1 )
I.EPi.linkE( E1 )
I.EPo.linkE( E2 )
C2.EPi.linkE( E2 )
C2.EPo.linkE( S2 )
R.EPi.linkE( E1 )
R.EPo.linkE( S2 )

estuff=Output( "estuff", filename="estuff.out" )
estuff.vars = [ ]

E1.con_1 = Constraint( E1, d1name="E1.IinIp1", d2name="E1.IoutI", depname="E1.dep_2", active=False )
E1.con_2 = Constraint( E1, d1name="E1.IinIp2", d2name="E1.IoutI", depname="E1.dep_2", active=False )
	


varsg.check()

varsg.NS = Newton( "varsg.NS" )

varsg.NS.run()

print( "converged",  varsg.NS.converged )

varsg.stdOut.print()


varsg.prettyPrint.print()


