
    def gamma( T, P, FAR, p ):
        return interp_3d( FAR, P, T, Newtherm.FAR_TP, Newtherm.P_TP, Newtherm.T_TP, Newtherm.gam_TPt, p )

    def rho( T, P, FAR, p  ):
        return interp_3d( FAR, P, T, Newtherm.FAR_TP, Newtherm.P_TP, Newtherm.T_TP, Newtherm.rho_TPt, p )

    def Cp( T, P, FAR, p ):
        return interp_3d( FAR, P, T, Newtherm.FAR_TP, Newtherm.P_TP, Newtherm.T_TP, Newtherm.Cp_TPt, p )

    def h_TP( T, P, FAR, p ):
        return interp_3d( FAR, P, T, Newtherm.FAR_TP, Newtherm.P_TP, Newtherm.T_TP, Newtherm.h_TPt, p )

    def s_TP( T, P, FAR, p ):
        return interp_3d( FAR, P, T, Newtherm.FAR_TP, Newtherm.P_TP, Newtherm.T_TP, Newtherm.s_TPt, p )

    def R( T, P, FAR, p ):
        return interp_3d( FAR, P, T, Newtherm.FAR_TP, Newtherm.P_TP, Newtherm.T_TP, Newtherm.R_TPt, p )

    def mu( T, P, FAR, p ):
        return 0

    def k( T, P, FAR, p ):
        return 0

    def T_sP( s, P, FAR, p ):
        T = 1500
        scalc = Newtherm.s_TP( T, P, FAR, p )

        errorm1 = ( scalc - s )/s
        xm1 =  T
        T = T*.95
        scalc = Newtherm.s_TP( T, P, FAR, p )
        error = ( scalc - s )/ s
        x = T
        count = 0
        while abs( error ) > .0000001 and count < 50:
            count = count + 1
            xp1 = x - error * (x - xm1 ) / ( error - errorm1 )
            if xp1 - x > .3*T:
                xp1 = x + .3*T
            if xp1 - x < -.3*T:
                xp1 = x - .3*T
            xm1 = x
            errorm1 = error
            x = xp1
            T = x
            scalc = Newtherm.s_TP( T, P, FAR, p )
            error = ( scalc - s )/ s

        if count > 49:
            varsg.errors = varsg.errors + "Error in T_sp"

        return T

    def T_hp( h, P, FAR, p ):
        T = 1500
        hcalc = Newtherm.h_TP( T, P, FAR, p )
        errorm1 = ( hcalc - h )/h
        xm1 =  T
        T = T*.95
        hcalc = Newtherm.h_TP( T, P, FAR, p )
        error = ( hcalc - h )/ h
        x = T
        count = 0
        while abs( error ) > .000001 and count < 50:
            count = count + 1
            xp1 = x - error * (x - xm1 ) / ( error - errorm1 )
            if xp1 - x > .3*T:
                xp1 = x + .3*T
            if xp1 - x < -.3*T:
                xp1 = x - .3*T
            xm1 = x
            errorm1 = error
            x = xp1
            T = x
            hcalc = Newtherm.h_TP( T, P, FAR, p )
            error = ( hcalc - h )/ h
        if count > 49:
            varsg.errors = varsg.errors + "Error in T_hp"


        return T
