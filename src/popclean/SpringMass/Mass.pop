from Element import Element
from Dependent import Dependent
from State import State
from Independent import Independent
from ComplexT import ComplexT
from RealT import RealT
from BooleanT import BooleanT
import g
import time

class Mass( Element ):

    def __init__( m, name ):
        super().__init__( name, "Mass" )
        m.name = name

        m.desc = "This element is nodal x location for a mass spring system."

        # force connections
        m.port_list = list()

        #solver stuff
        m.ind_x = Independent( m, indname="xloc", perturb=.05, scale=1., perturb_type="Absolute", active=True, desc="Varies the x location of the mass" )
        m.ind_V = Independent( m, indname="V", perturb=.05, scale=100., perturb_type="Absolute", active=True, desc="Varies the x location of the mass" )

        m.state_1 = State( m, d1name="Fp", d2name="Fn", sname="xloc", dsname="V", val_scale=100., active=True, desc="X integration" )
        m.state_2 = State( m, d1name="V", d2name="0.", sname="V", dsname="dVdt", val_scale=100., active=True, desc="V integration" )

        # Variables
        m.xloc = RealT( m, units="ft", desc="X location of the node" )
        m.Fp = RealT( m, units="lbf", desc="Force in the positive direction" )
        m.Fn = RealT( m, units="lbf", desc="Force in the negative direction" )
        m.mass = RealT( m, units="lbm", desc="Mass" )
        m.V = RealT( m, units="ft/sec", desc="Velocity of the mass" )
        m.dVdt = RealT( m, units="ft/secw", desc="Derivative of the velocity" )
        m.dxdt = RealT( m, units="ft/sec", desc="Derivative of the x-position" )
        m.vert = BooleanT( m, v=True, desc="deterimes in gravity is acting on spring" )

        m.initialList()

    # first step in solver pass is to set the voltage in all of the ports
    def preset( m ):
        for p in m.port_list:
            p.setxV( m.xloc, m.V )

    # before anything is run at all, loop through all substructures to find the
    # ports
    def precheck( m ):
        m.port_list = list()
        for p in m.VIDL:
            if p.isa( "Fp" ):
                m.port_list.append( p )


    def calc( m ):

        # zero out the running current totals
        m.Fp.set( 0. )
        if m.vert == True:
            m.Fp.set( m.mass )
        m.Fn.set( 0. )

        # loops through the ports
        # if current coming in, add it to in total
        # if current going out, add it to the out total
        for p in m.port_list:
            if p.io == "in":
                if p.F > 0.:
                    m.Fp = m.Fp + p.F
                else:
                    m.Fn = m.Fn - p.F
            else:
                if p.F > 0.:
                    m.Fn = m.Fn + p.F
                else:
                    m.Fp = m.Fp - p.F

        # calculate the derivative
        m.dVdt = ( m.Fp - m.Fn )/( m.mass )* 32.2



    def dump( self ):
        print( self.name, "Node", file = g.out )
        super().realPrint()

    def pretty( m ):
        print( f"{"Fp"[:10]:12s}{m.name1[:10]:12s}{("xloc:"+str(m.xloc))[:10]:12s}{("V:"+str(m.V))[:10]:12s}{("mass:"+str(m.mass))[:10]:12s}" , file=g.pretty )
