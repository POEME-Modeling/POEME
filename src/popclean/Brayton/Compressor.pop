from Element import Element
from RealT import RealT
from ComplexT import ComplexT
from StringT import StringT
from FN import FN
from Table1d import Table1d
from MP import MP
import g
from Table2d import Table2d
from BooleanT import BooleanT
from Dependent import Dependent
from Independent import Independent


class Compressor( Element ):


    def __init__( c, name ):
        super().__init__( name, "Compressor" )
        c.type = "Compressor"

        c.desc = "Basic compressor.  This compressor reads in maps of effeciency, " \
        + "correct flow and pressure ratio as a function of R-line and correctec " \
        + "speed.  The element enables two bleed flows to be taken off."

        # tables
        c.effTable = Table2d( c, desc="Table of efficiency versus corrected speed and Rline" )
        c.PRtable = Table2d( c, desc="Table of pressure ratio versus corrected speed and flow" )
        c.WcTable = Table2d( c, units="lbm/sec", desc="Table of corrected flow versus corrected speed and flow" )

        # fluid locations/ports
        c.FNi = FN( c,  io="in", desc="Incoming fluid flow" )
        c.FNideal = FN( c, desc="Ideal exit conditions" )
        c.FNo = FN( c,  io="out", desc="Outgoing fluid flow" )
        c.FNoBld1 = FN( c, io="out", desc="Bleed flow 1" )
        c.FNoBld2 = FN( c, io="out", desc="Bleed flow 2" )

        # mechanical connections
        c.MP = MP( c, io="out", desc="Mechanicl port connectio" )

        # solver stuff
        c.ind_CR = Independent( c, indname="Rline", perturb=.05, scale=100, perturb_type="Relative", active=False, desc="Varies R-line" )
        c.dep_CW = Dependent( c, d1name="Wc", d2name="WcMap", active=False, desc="Handles weight flow error" )

        # variables
        c.eff = RealT( c, units="none", desc="Efficiency" )
        c.effDes = RealT( c, units="none", desc="Design efficiency" )
        c.effMap = RealT( c, units="none", desc="Efficiency read from table" )
        c.effScale = RealT( c, units="none", desc="Scalar on efficiency map" )
        c.hfract1 = RealT( c, units="BTU/lbm", desc="Enthalpy fraction that determines how down the compressor the bleed is taken" )
        c.hfract2 = RealT( c, units="BTU/lbm", desc="Enthalpy fraction that determines how down the compressor the bleed is taken" )
        c.Nc = RealT( c, units="RPM/R**.5", desc="Corrected speed" )
        c.NcMap = RealT( c, units="RPM/R**.5", desc="Corrected speed used to read the map" )
        c.NcMapDes = RealT( c, units="RPM/R**.5", desc="Design point corrected speed" )
        c.NcScale = RealT( c, units="none", desc="Scalar on corrected speed" )
        c.PR = RealT( c, units="none", desc="Pressure ratio" )
        c.PRdes = RealT( c, units="none", desc="Design pressure ratio" )
        c.PRmap = RealT( c, units="none", desc="Pressure ratio read from table" )
        c.PRscale = RealT( c, units="none", desc="Scalar on pressure ratio map" )
        c.Rline = RealT( c, units="none", desc="Current R-line" )
        c.RlineDes = RealT( c, units="none", desc="Design point R-line" )
        c.SMN = RealT( c, units="none", desc="stall margin based on corrected speed" )
        c.Wc = RealT( c, units="lbm/sec", desc="Corrected flow" )
        c.WcDes = RealT( c, units="lbm/sec", desc="Design corrected flow" )
        c.WcMap = RealT( c, units="lbm/sec", desc="Map corrected flow" )
        c.WcScale = RealT( c, units="none", desc="Scalar on corrected flow" )
        c.Wfrac1 = RealT( c, units="none", desc="Weight flow fraction for bleed flow 1" )
        c.Wfrac2 = RealT( c, units="none", desc="Weight flow fraction for bleed flow 2" )

        c.size = BooleanT( c, v=True, desc="Determine if the element is in design mode or not" )
        c.initialList()

    def calc(c):

        # copy incoming flow to other ports
        c.FNo.copy( c.FNi )
        c.FNoBld1.copy( c.FNi )
        c.FNoBld1.setW( 0. )
        c.FNoBld2.copy( c.FNi )
        c.FNoBld2.setW( 0. )
        c.FNideal.copy( c.FNi )

        # calculate corrected speed amd corrected flow
        c.Nc = c.MP.N/( c.FNi.Tt )**.5
        c.Wc = c.FNi.W*( c.FNi.Tt )**.5/ c.FNi.Pt
        c.Wc = c.FNi.W*( c.FNi.Tt )**.5/ c.FNi.Pt

        # if we are in design mode set the conditions
        if c.size == True:
            c.NcScale = c.NcMapDes / c.Nc
            c.WcDes = c.Wc
            c.Rline = c.RlineDes

        # scale the corrected speed
        c.NcMap = c.NcScale*c.Nc

        # read the maps
        c.effMap = c.effTable.calc( c.NcMap, c.Rline )
        c.PRmap = c.PRtable.calc( c.NcMap, c.Rline )
        c.WcMap = c.WcTable.calc( c.NcMap, c.Rline )

        # if in desing mode determine the scale factors
        if c.size == True:
            c.effScale = c.effDes / c.effMap
            c.PRscale = c.PRdes / c.PRmap
            c.WcScale = c.WcDes / c.WcMap

        # scale the map values
        c.eff = c.effMap*c.effScale
        c.PR = c.PRmap*c.PRscale
        c.WcMap = c.WcScale*c.WcMap
        c.SMN = ( c.PRmap - c.PRtable.calc( c.NcMap, c.Rline ) )/ c.PRmap

        # determine the ideal conditions
        c.FNideal.set_sP( c.FNi.s, c.PR*c.FNi.Pt )

        # determine the actual exit conditions
        htOut = c.FNi.ht+( c.FNideal.ht - c.FNi.ht )/ c.eff
        c.FNo.set_hP( htOut, c.PR*c.FNi.Pt )

        # set the bleed exit conditions
        if c.Wfrac1 > 0.:
            c.FNoBld1.setW(  c.Wfrac1*c.FNi.W )
            c.FNoBld1.set_hP( c.FNi.ht + c.hfract1*( c.FNo.ht - c.FNi.ht ), c.hfract1*(c.FNo.Pt - c.FNi.Pt ))
        if c.Wfrac2 > 0.:
            c.FNoBld2.setW( c.Wfrac2*c.FNi.W )
            c.FNoBld2.set_hP( c.FNi.ht + c.hfract2*( c.FNo.ht - c.FNi.ht ), c.hfract2*(c.FNo.Pt - c.FNi.Pt ))

        c.FNo.setW( c.FNo.W - c.FNoBld1.W - c.FNoBld2.W )

        # set the exit conditions
        c.MP.setHP(  -1.*(( c.FNo.ht - c.FNi.ht )*c.FNo.W*3600./2545. +
         ( c.FNoBld1.ht - c.FNi.ht )*c.FNoBld1.W*3600./2545.+
         ( c.FNoBld2.ht - c.FNi.ht )*c.FNoBld2.W*3600./2545. ) )





    def precheck( c ):

        # design point turn off solver stuff
        if c.size == True:
            c.ind_CR.active = False
            c.dep_CW.active = False
        # off design turn on solver stuff
        else:
            c.ind_CR.active = True
            c.dep_CW.active = True



    def dump( c ):
        #dump output variables
        print( c.name1, "Compressor", file=g.out )
        super().realPrint()

    def pretty( c ):
        print( f"{"Compressor"[:10]:12s}{c.name1[:10]:12s}{("PR:"+str(c.PR))[:10]:12s}{("eff:"+str(c.eff))[:10]:12s}{("Rline:"+str(c.Rline))[:10]:12s}{("NcMap:"+str(c.NcMap))[:10]:12s}" , file=g.pretty )
