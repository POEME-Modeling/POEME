
exec( open( "pop.std").read())

loadDirectory( "../pop" )
loadDirectory( "../SpringMass" )

exec( open( "temp.include").read())
import g
g.out = open( "pop.out", "a")
g.pretty = open( "pretty.out", "a")


W1 = Wall( "W1" )
W1.xloc+= 0.
W1.Fp1 = Fp( W1, "in", "" )
W1.Fp2 = Fp( W1, "in", "" )

S1 = Spring( "S1" )
S1.k += .1
S1.LN += 3.

D1 = Damper( "Damper" )
D1.c += .01

M1 = Mass( "Mass" )
M1.mass += 1.
M1.xloc += 3.
M1.Fp1 = Fp( M1, "in", "" )
M1.Fp2 = Fp( M1, "in", "" )

S1.Fp1.linkFp( W1.Fp1 )
S1.Fp2.linkFp( M1.Fp1 )

D1.Fp1.linkFp( W1.Fp2 )
D1.Fp2.linkFp( M1.Fp2 )

g.check()

g.NS = Newton( "g.NS" )

estuff=Output( "estuff" )
estuff.filename += "estuff.out"
estuff.vars = [ g.NS.time, S1.L, M1.xloc ]

g.NS.solve()

g.set( "trans", True )
g.NS.timeLast.set( 100. )
g.NS.dtime.set( .01 )

M1.xloc += M1.xloc + 1.

g.NS.trim()


print( M1.x )


g.NS.run()
