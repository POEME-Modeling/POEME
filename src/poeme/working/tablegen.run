s=[]
s1=[]
s2= []
h=[]
h1=[]
h2=[]
rho=[]
rho1=[]
rho2=[]
R=[]
R1=[]
R2=[]
gamma=[]
gam1=[]
gam2=[]
Cp=[]
Cp1=[]
Cp2=[]

FN = FN( 0 )

FN.comp.set( "CanteraFN" )
for FAR in FAR_TP:
	for P in P_TP:
		for T in T_TP:
			FN.FAR.set( FAR )
			FN.set_tp( T, float( P ) )
			s.append( FN.s.v )
			h.append( FN.ht.v )
			rho.append( FN.rhot.v )
			R.append( FN.Rt.v )
			gamma.append( FN.gamt.v )
			Cp.append( FN.Cpt.v )
		h1.append( h )
		h=[]
		s1.append( s )
		s=[]
		rho1.append( rho )
		rho=[]
		R1.append( R )
		R=[]
		gam1.append( gamma )
		gamma=[]
		Cp1.append( Cp )
		Cp=[]
	h2.append( h1 )
	h1=[]
	s2.append( s1 )
	s1=[]
	rho2.append( rho1 )
	rho1=[]
	R2.append( R1 )
	R1=[]
	gam2.append( gam1 )
	gam1=[]
	Cp2.append( Cp1 )
	Cp1=[]



f = open("table.data", "w")

print( "    T_TP = ", T_TP, file=f )
print( "    P_TP = ", P_TP, file=f )
print( "    FAR_TP = ", FAR_TP, file=f )
print( "    h_TPt = ", h2,file=f )
print( "    s_TPt = ", s2, file=f )
print( "    rho_TPt = ", rho2, file=f )
print( "    R_TPt = ", R2, file=f )
print( "    gam_TPt = ", gam2, file=f )
print( "    Cp_TPt = ", Cp2, file=f )

f.close()

os.system( "type table.top table.data table.bottom > Newtherm.py" )
