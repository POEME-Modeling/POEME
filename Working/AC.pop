

exec( open( "pop.std").read())
loadDirectory( "../pop" ) 
loadDirectory( "../Brayton" ) 
exec( open( "temp.include").read())
import g
g.out = open( "pop.out", "a")
g.pretty = open( "pretty.out", "a")	
	
FSE = FlowStartEnd2D( "FSE" )
FSE.Pt = 43.5
FSE.comp = "CPR134"
FSE.FNo.twoPhase = True
FSE.FNo.comp = "CPR134"
FSE.FNo.setTP( 506., 43.5 )
FSE.ht = FSE.FNo.ht
FSE.W = 30.

Comp = Compressor( "Comp" )

Condensor = Duct( "Condesor" )
Condensor.dP = .0
Condensor.Q =-1000.

Valve = Duct( "Valve" )
Valve.dP = ( 1.-1.4/9. )

Evap = Duct( "Evap" )
Evap.dP = .00
Evap.Q = +500.

Comp.PRdes = 9./1.4 
Comp.effDes = .89 
Comp.MP.setN( 6000. )
Comp.NcMapDes = .9 
Comp.RlineDes = 2.0  
Comp.effTable.x = [ .8, .95, 1.1 ]
Comp.effTable.y = [ 1., 2.0, 3.0 ]
Comp.effTable.data = [ [ .90, .93, .90],\
               [.92, .95, .92 ],\
               	   [.89, .92, .88 ]]
Comp.PRtable.x = [ .8, .95, 1.1 ]
Comp.PRtable.y = [ 1., 2.0, 3.0 ]
Comp.PRtable.data = [ [ 6.183, 4.572 ,2.455],\
               [16.044, 17.705,7.148],\
			[  37.995, 27.657,14.535]]

Comp.WcTable.x = [ .8, .95, 1.1]
Comp.WcTable.y = [ 1., 2.0, 3.0 ]
Comp.WcTable.data = [ [ 32.496, 34.173, 35.169],\
               [68.234, 72.934,74.243 ],\
               	   [ 118.945, 126.124,126.182]]


FSE.FNo.linkFN( Comp.FNi )
Comp.FNo.linkFN( Condensor.FNi )
Condensor.FNo.linkFN( Valve.FNi )
Valve.FNo.linkFN( Evap.FNi )
Evap.FNo.linkFN( FSE.FNi )

Comp.ind_PRdes = Independent( Comp, indname="PRdes", perturb=.05, scale=100, perturb_type="Relative", active=True, desc="Varies R-line" )        

Condensor.ind_Q = Independent( Condensor, indname="Q", perturb=.05, scale=100, perturb_type="Relative", active=True, desc="Varies R-line" )        



g.NS = Newton( "g.NS" )
g.check()

g.NS.solve()
g.NS.solve()
g.NS.solve()
g.NS.solve()
g.NS.solve()
g.NS.solve()
g.stdOut.print()
g.prettyPrint.print()

