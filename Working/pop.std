import os
import sys

if os.path.exists( "temp.include" ):
	os.remove( "temp.include" )




def loadDirectory( dir ):
	
	temp = open( "temp.include", "a" )
	current_directory = os.getcwd()
	files = os.listdir( dir )
	sys.path.insert(0, dir)
	os.chdir( dir )
	for f in files:
		if ".py" in f and not "~" in f: 
			f=f[:-3]
			exec( "from " + f + " import *" )
			if "varsg" in f or "." in f:
				pass
			else:
				temp.write( "from " + f + " import " + f + "\n")
		
	os.chdir( "..\Working" )
	temp.close()
	
def setComp( comp ):
	for e in varsg.element_list:
		for v in e.VIDL:
			if v.isa( "FN" ):
				if v.comp.v == "none":
					v.comp.set( comp )
					
def setFreq( freq ):
	for e in varsg.element_list:
		for v in e.VIDL:
			if v.isa( "EP" ):
				if v.freq.v == 0:
					v.freq.set( freq )
					
