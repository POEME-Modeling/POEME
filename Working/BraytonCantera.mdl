
exec( open( "pop.std").read())	
exec( open( "pop.std").read())
loadDirectory( "../pop" ) 
loadDirectory( "../Brayton" ) 
import varsg

varsg.out = open( "pop.out", "a")
varsg.pretty = open( "pretty.out", "a")


exec( open( "temp.include").read())

FS = FlowStart( "FS" )
#FS.W = 10.;
#checkType()
#quit()
FS.Pamb = RealT( FS, v=10. )
	
FS.Pt.set( 15. )
FS.Tt.set( 500. )
FS.W.set( 1000. )
FS.comp.set( "canteraFN" )

D1 = Duct( "D1" )
D1.dP.set( .05 )
D1.FNi.linkFN( FS.FNo )

C1 = Compressor( "C1" )
C1.PRdes.set( 20. )
C1.effDes.set( .89 )
C1.FNi.linkFN( D1.FNo )
C1.hfract1.set( .7 )
C1.Wfrac1.set( .02 )
C1.hfract2.set(  .9 )
C1.Wfrac2.set( .03 )
C1.NcMapDes.set( .9 )
C1.RlineDes.set( 2.0 ) 
C1.effTable.x = [ .8, .95, 1.1 ]
C1.effTable.y = [ 1., 2.0, 3.0 ]
C1.effTable.data = [ [ .90, .93, .90],\
               [.92, .95, .92 ],\
               	   [.89, .92, .88 ]]
C1.PRtable.x = [ .8, .95, 1.1 ]
C1.PRtable.y = [ 1., 2.0, 3.0 ]
C1.PRtable.data = [ [ 6.183, 4.572 ,2.455],\
               [16.044, 17.705,7.148],\
			[  37.995, 27.657,14.535]]

C1.WcTable.x = [ .8, .95, 1.1]
C1.WcTable.y = [ 1., 2.0, 3.0 ]
C1.WcTable.data = [ [ 32.496, 34.173, 35.169],\
               [68.234, 72.934,74.243 ],\
               	   [ 118.945, 126.124,126.182]]

B1 = Burner( "B1" )

B1.FAR.set( .025 )
B1.LHV.set( -500. )

B1.FNi.linkFN( C1.FNo )

T1= Turbine( "T1" )
T1.effDes.v = .95
T1.FNi.linkFN( B1.FNo )
T1.FNiBld1.linkFN( C1.FNoBld2 )
T1.FNiBld2.linkFN( C1.FNoBld1 )
T1.effTable.x = [ .8, .9, 1.1 ]
T1.effTable.y = [ 2., 3.0, 6.0 ]
T1.effTable.data = [ [ .90, .91, .87],\
               [.92, .95, .90 ],\
               	   [.89, .92, .88 ]]
T1.WcTable.x = [.8, .9, 1.1 ]
T1.WcTable.y = [ 1.0, 3.0, 6.0 ]
T1.WcTable.data = [ [ 21.6, 21.6, 21.6],\
               [19.4, 19.4, 19.4 ],\
               	   [ 17.3, 17.3, 17.3]] 


T1.NcMapDes.set( .9 )
T1.PRmapDes.set( 3. )
T1.PR.set( 3.5 )
#T1.FNo.MN.set( .3 )

N1 = Nozzle( "N1" )
N1.FNi.linkFN( T1.FNo )
N1.PsExh.set( "FS.Pamb" )

S1 = Shaft( "S1" )

S1.MPC = MP( S1, io="in" )
S1.MPT = MP( S1, io="in" )
S1.N.set( 10000. )
S1.MPC.linkMP( C1.MP )
S1.MPT.linkMP( T1.MP )
S1.I.set( 6.)

P1 = Perf( "P1" )


estuff=Output( "estuff", filename="estuff.out" )
estuff.vars = [ varsg.NS.time, T1.FNo.MN, T1.FNo.Ps, B1.FAR,B1.FNi.W, B1.Wfuel, S1.N, FS.W, T1.FNo.A ]
estuff.vars = [ varsg.NS.time, B1.FAR,S1.N, B1.Wfuel, B1.FNo.Tt ]

checkType()
quit()
varsg.check()

varsg.NS.solve()
varsg.stdOut.print()


varsg.set("size", False )

varsg.check()

varsg.NS.solve()


B1.FAR.set( .025 )

varsg.NS.solve()

B1.FAR.set( .026 )

varsg.NS.solve()

B1.FAR.set( .027 )

varsg.NS.run()


B1.FAR.set( .030 )

varsg.NS.run()

B1.FAR.set( .025 )


varsg.NS.run()


B1.FAR.set( .025 )

varsg.NS.run()



B1.FAR.set( .025 )


varsg.NS.run()

PIV1 = PIV( "PIV1" )

PIV1.P.set( .00000005 )

 
PIV1.DPo.set( "B1.FAR" )
PIV1.DPi.set( "S1.N" )

B1.WFset.set( False )
	
PIV1.G.set( 10500. )

varsg.NS.timeLast.set( 10. )
varsg.NS.dtime.set( .01 )
varsg.set("trans", True )
varsg.NS.tolerance.set( .0002 )
varsg.NS.trim()
varsg.NS.run()




	